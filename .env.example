# ARK RUNNER — environment (Phase 5+; the greybox needs none of this)

# --- Settlement provider ---
# true  = MockSettlementProvider (no chain; dev/demo/tests)
# false = ArchSettlementProvider (real Arch Network)
MOCK_BLOCKCHAIN=true

# --- Arch Network (only when MOCK_BLOCKCHAIN=false) ---
ARCH_RPC_URL=https://rpc.testnet.arch.network
ARCH_INDEXER_URL=https://explorer.arch.network/api/v1/testnet
ARCH_NETWORK=testnet

# Prize/entry asset (APL token mints on Arch testnet)
# aBTC (8 decimals) or aUSD (6 decimals)
ARCH_ENTRY_MINT=1d46e0dd...            # aBTC mint (fill exact)
ARCH_ENTRY_DECIMALS=8

# Program that holds escrow PDAs + does program-signed payouts (reused from Scramble pattern)
ARCH_SETTLEMENT_PROGRAM_ID=

# Settlement authority — SERVER-SIDE ONLY, never shipped to the client.
# The program pins this pubkey; the key signs payouts after replay-validating a run.
ARCH_SETTLEMENT_AUTHORITY_SECRET=

# --- Backend (Phase 4+) ---
DATABASE_URL=postgres://localhost:5432/arkrunner
REDIS_URL=redis://localhost:6379
