# ARCH RUNNER — environment (Phase 5+; the greybox needs none of this)

# --- Settlement provider ---
# true  = MockSettlementProvider (no chain; dev/demo/tests)
# false = ArchSettlementProvider (real Arch Network)
MOCK_BLOCKCHAIN=true

# --- Arch Network (only when MOCK_BLOCKCHAIN=false) ---
# Testnet RPC is keyless (verified live 2026-10-08). SDK: @arch-network/arch-sdk 0.0.28.
ARCH_RPC_URL=https://rpc.testnet.arch.network
ARCH_NETWORK=testnet
# Indexer: arch-indexer is self-hosted (REST /api/*). Set to your own deployment.
# No official hosted indexer base URL is confirmed (see docs/arch-assumptions.md U4).
ARCH_INDEXER_URL=http://localhost:3000/api

# Prize/entry asset: OUR OWN APL token (Token Program + ATA). There is NO protocol-native
# aBTC/archUSD/aUSD (see docs/arch-capabilities.md). The LIVE testnet mint is decimals-0.
ARCH_ENTRY_MINT=3rc7Mkh4vYT2LXKADeoQd8kTFMzdZxyHPSTV5KmWSMH2   # base58 (hex 2a6c88…d929)
ARCH_ENTRY_DECIMALS=0                    # the deployed mint is decimals-0 (entry = 10 whole tokens)

# Settlement program — LIVE on testnet (docs/DEPLOYMENT_RESULT.md). The hex ids are also
# hard-wired in src/chain/archRead.ts so the client/read path needs no env.
ARCH_SETTLEMENT_PROGRAM_ID=8R9MfjGyBcduUTZAR91ruyyCDXX4BYAHSWCQzaR5duL5   # base58 (hex 6e3132…0e42)

# ========================= SETTLEMENT SERVICE (server/) =========================
# Port for the Node settlement service (server/index.ts).
SETTLE_PORT=8790

# Settlement-authority SECRET — SERVER-SIDE ONLY, NEVER in the client bundle or git.
# Accepts EITHER a 64-hex secret OR a path to a file containing it (a file path is
# preferred so the secret never lands in the process table). The `arch-settle` signer
# child process is the only thing that reads it. Pinned pubkey: 9sZMrF3N… (hex 83d1…f3f5).
#   example (file):  ARCH_SETTLEMENT_AUTHORITY_SECRET=/secure/path/authority.json
ARCH_SETTLEMENT_AUTHORITY_SECRET=

# Optional: override the compiled signer binary location (default:
# server/arch-settle/target/release/arch-settle). Build it with `npm run settle:build`.
ARCH_SETTLE_BIN=

# --- Client → service wiring (browser) ---
# Base URL of the settlement service the client submits runs to / delegates settle to.
# The client NEVER holds the authority key; it only reads chain state + POSTs here.
VITE_SETTLEMENT_SERVICE_URL=http://localhost:8790

# --- Backend (Phase 4+) ---
DATABASE_URL=postgres://localhost:5432/archrunner
REDIS_URL=redis://localhost:6379
