{
  "name": "ark-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ARK RUNNER — an async competitive 3D endless runner powered by Arch Network.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "tsx src/server/index.ts",
    "simulate": "tsx src/economy/simulate.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
